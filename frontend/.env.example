# Supabase configuration for frontend (clientless direct PostgREST mode)
# Copy this file to a new file named '.env' in this folder and fill in your Supabase credentials.
# You can find these values in Supabase under Project Settings -> API.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
