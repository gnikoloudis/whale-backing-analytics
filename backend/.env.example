# Backend Environment Configuration
# Copy this file to a new file named '.env' in this folder and fill in your details.

# Connection string to your database.
# For local SQLite (default): sqlite:///./local.db
# For Supabase (PostgreSQL): postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
